{
  "name": "@mdh/render",
  "version": "1.0.0",
  "type": "module",
  "description": "mdh 渲染层：把 AST 画成页面，含编号计算与增删查改",
  "keywords": [
    "mdh",
    "render",
    "html",
    "ast"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@mdh/core": "1.0.0"
  },
  "scripts": {
    "build": "tsup"
  }
}
